<Window x:Class="Blackjack.DeckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blackjack"
        Title="Remaining Deck"
        Height="500"
        Width="650"
        MinHeight="350"
        MinWidth="500"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <local:CardImageConverter x:Key="CardImageConverter"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- List of Remaining Cards -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Cards Remaining"
                           FontWeight="Bold"
                           FontSize="18"
                           Margin="0,0,0,8"/>

                <ListBox x:Name="deckList"
                         ItemsSource="{Binding}"
                         SelectionMode="Single"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="15"
                                       Margin="3"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Selected Card Image -->
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock Text="Selected Card"
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <Border BorderBrush="Gray"
                        BorderThickness="1"
                        Background="#F0F0F0"
                        Padding="10">

                    <Image Width="180"
                           Height="260"
                           Stretch="Uniform"
                           Source="{Binding SelectedItem,
                                    ElementName=deckList,
                                    Converter={StaticResource CardImageConverter}}"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Move Cards -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0">

            <Button Content="Move Up"
                    Width="120"
                    Margin="5"
                    Padding="10,7"
                    Click="MoveUp_Click"/>

            <Button Content="Move Down"
                    Width="120"
                    Margin="5"
                    Padding="10,7"
                    Click="MoveDown_Click"/>
        </StackPanel>
    </Grid>
</Window>
