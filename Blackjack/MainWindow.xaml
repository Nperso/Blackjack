<Window x:Class="Blackjack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Blackjack"
        Title="Blackjack"
        Height="650"
        Width="950"
        MinHeight="550"
        MinWidth="750"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:CardImageConverter x:Key="CardImageConverter"/>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Background="#176B43">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="BLACKJACK"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="10,15"/>

        <!-- Dealer Hand -->
        <StackPanel Grid.Row="1" Margin="20,5">
            <TextBlock Text="Dealer Hand"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding DealerScore,
                              StringFormat='Dealer Score: {0}'}"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="5"/>

            <ListBox ItemsSource="{Binding DealerHand}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Center"
                     Height="150">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding Converter={StaticResource CardImageConverter}}"
                               Width="90"
                               Height="130"
                               Stretch="Uniform"
                               Margin="5"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- Player Hand -->
        <StackPanel Grid.Row="2" Margin="20,5">
            <TextBlock Text="Player Hand"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding PlayerScore,
                              StringFormat='Player Score: {0}'}"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="5"/>

            <ListBox ItemsSource="{Binding PlayerHand}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Center"
                     Height="150">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding Converter={StaticResource CardImageConverter}}"
                               Width="90"
                               Height="130"
                               Stretch="Uniform"
                               Margin="5"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- Game Status -->
        <TextBlock Grid.Row="3"
                   Text="{Binding GameStatus}"
                   Foreground="White"
                   FontSize="17"
                   FontWeight="Bold"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="10"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="10">

            <Button Content="New Game"
                    Click="NewGame_Click"
                    Background="#F4F4F4"/>

            <Button Content="Hit"
                    Click="Hit_Click"
                    Background="#F4F4F4"/>

            <Button Content="Deck"
                    Click="Deck_Click"
                    Background="#F4F4F4"/>
        </StackPanel>
    </Grid>
</Window>
